# Environment variables for local development and Render deployment
# Copy this file to .env and fill in the values for your environment.

ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=*
LIBREOFFICE_PATH=/usr/bin/soffice
PDF_TIMEOUT=90

# Storage backend: local or s3
STORAGE_BACKEND=local

# AWS S3 configuration (used only when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Render-specific
PYTHON_VERSION=3.11.0
PORT=8000
